generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── CATEGORY ───────────────────────────────────────────────
// Cakes, Pastries, Platters
model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
}

// ─── PRODUCT ────────────────────────────────────────────────
// e.g. Red Velvet Cake, Meat Pie, Beef Platter
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  hasVariants   Boolean  @default(false)
  basePriceKobo Int?
  currency      String   @default("NGN")
  inStock       Boolean  @default(true)
  isPlatter     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([slug])
  @@index([inStock])
}

// ─── PRODUCT VARIANT ────────────────────────────────────────
// Used for cakes (size + layers), pastries (quantity),
// and platters (small/medium/large)
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String
  priceKobo  Int
  currency   String   @default("NGN")
  inStock    Boolean  @default(true)
  sizeInches Int?
  layers     Int?
  quantity   Int?
  createdAt  DateTime @default(now())

  orderItems OrderItem[]

  @@unique([productId, label])
  @@index([productId])
}

// ─── CUSTOMER ───────────────────────────────────────────────
model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([email])
}

// ─── ORDER ──────────────────────────────────────────────────
model Order {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id])
  status     OrderStatus @default(PENDING)
  totalKobo  Int
  currency   String      @default("NGN")
  notes      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items      OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

// ─── ORDER ITEM ─────────────────────────────────────────────
// One line in an order.
// unitPriceKobo stores the price at time of order — never changes.
model OrderItem {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Int
  unitPriceKobo Int
  currency      String          @default("NGN")
  createdAt     DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

// ─── ORDER STATUS ────────────────────────────────────────────
enum OrderStatus {
  PENDING
  CONFIRMED
  BAKING
  READY
  DELIVERED
  CANCELLED
}